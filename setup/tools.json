[
 {"id": "git", "name": "Git", "area": "base", "check": "Test-Command git",
  "install": ["Install-Winget Git.Git"], "check_mac": "command -v git", "install_mac": ["brew install git"],
  "check_linux": "command -v git", "install_linux": ["$SUDO apt-get update -qq", "$SUDO apt-get install -y git"]},
 {"id": "python", "name": "Python (3.12 or newer)", "area": "base", "check": "(& python --version 2>&1) -match '^Python 3\\.1[2-9]'",
  "install": ["Install-Winget Python.Python.3.12"],
  "check_mac": "command -v python3.12 >/dev/null || brew list --versions python@3.12 >/dev/null 2>&1 || python3 --version 2>&1 | grep -Eq '^Python 3\\.1[2-9]'",
  "install_mac": ["brew install python@3.12"],
  "check_linux": "python3 --version 2>&1 | grep -Eq '^Python 3\\.1[2-9]'",
  "install_linux": ["$SUDO apt-get update -qq", "$SUDO apt-get install -y python3 python3-pip python3-venv"]},
 {"id": "node", "name": "Node.js", "area": "base", "check": "(& node --version 2>&1) -match '^v(2[2-9]|[3-9][0-9])'",
  "install": ["Install-Winget OpenJS.NodeJS.LTS"], "check_mac": "node --version 2>&1 | grep -Eq '^v(2[2-9]|[3-9][0-9])'", "install_mac": ["brew install node"],
  "check_linux": "node --version 2>&1 | grep -Eq '^v(2[2-9]|[3-9][0-9])'",
  "install_linux": ["$SUDO apt-get update -qq", "$SUDO apt-get install -y curl ca-certificates",
                    "curl -fsSL -o /tmp/nodesource_setup.sh https://deb.nodesource.com/setup_22.x", "$SUDO bash /tmp/nodesource_setup.sh", "$SUDO apt-get install -y nodejs"]},
 {"id": "uv", "name": "uv (runs Python tools)", "area": "base", "check": "Test-Command uv",
  "install": ["Install-Winget astral-sh.uv"], "check_mac": "command -v uv", "install_mac": ["brew install uv"],
  "check_linux": "command -v uv >/dev/null || test -x \"$HOME/.local/bin/uv\"",
  "install_linux": ["$SUDO apt-get update -qq", "$SUDO apt-get install -y curl ca-certificates", "curl -LsSf https://astral.sh/uv/install.sh | sh"]},
 {"id": "ffmpeg", "name": "ffmpeg (video and audio)", "area": "base", "check": "Test-Command ffmpeg",
  "install": ["Install-Winget Gyan.FFmpeg"], "check_mac": "command -v ffmpeg", "install_mac": ["brew install ffmpeg"],
  "check_linux": "command -v ffmpeg", "install_linux": ["$SUDO apt-get update -qq", "$SUDO apt-get install -y ffmpeg"]},
 {"id": "yt-dlp", "name": "yt-dlp (video download and captions)", "area": "base", "check": "Test-Command yt-dlp",
  "install": ["Install-Winget yt-dlp.yt-dlp"], "check_mac": "command -v yt-dlp", "install_mac": ["brew install yt-dlp"],
  "check_linux": "command -v yt-dlp >/dev/null || test -x \"$HOME/.local/bin/yt-dlp\"", "install_linux": ["pip3 install --break-system-packages -U yt-dlp"]},
 {"id": "playwright", "name": "Playwright browser (for the site tools)", "area": "base", "needs": ["node"],
  "check": "Test-Path \"$env:LOCALAPPDATA\\ms-playwright\"", "install": ["npx --yes playwright install chromium"],
  "check_mac": "test -d \"$HOME/Library/Caches/ms-playwright\"", "install_mac": ["npx --yes playwright install chromium"],
  "check_linux": "test -d \"$HOME/.cache/ms-playwright\"", "install_linux": ["$SUDO npx --yes playwright install-deps chromium", "npx --yes playwright install chromium"]},

 {"id": "claude", "name": "Claude Code", "area": "claude", "adapter": "claude-code", "check": "Test-Command claude",
  "install": ["Invoke-RestMethod https://claude.ai/install.ps1 | Invoke-Expression", "Update-SessionPath"],
  "check_mac": "command -v claude", "install_mac": ["curl -fsSL https://claude.ai/install.sh | bash"],
  "login": "Claude opens your browser to sign in the first time it runs."},
 {"id": "plugin-superpowers", "name": "Claude plugin: superpowers", "area": "plugins", "adapter": "claude-code", "needs": ["claude"],
  "check": "(& claude plugin list 2>&1) -match 'superpowers@'",
  "install": ["Add-ClaudePlugin anthropics/claude-plugins-official claude-plugins-official superpowers"],
  "check_mac": "claude plugin list 2>&1 | grep -q 'superpowers@'",
  "install_mac": ["claude plugin marketplace add anthropics/claude-plugins-official || true", "claude plugin install superpowers@claude-plugins-official"]},
 {"id": "plugin-frontend-design", "name": "Claude plugin: frontend-design", "area": "plugins", "adapter": "claude-code", "needs": ["claude"],
  "check": "(& claude plugin list 2>&1) -match 'frontend-design@'",
  "install": ["Add-ClaudePlugin anthropics/claude-plugins-official claude-plugins-official frontend-design"],
  "check_mac": "claude plugin list 2>&1 | grep -q 'frontend-design@'",
  "install_mac": ["claude plugin marketplace add anthropics/claude-plugins-official || true", "claude plugin install frontend-design@claude-plugins-official"]},
 {"id": "plugin-document-skills", "name": "Claude plugin: document-skills (Word, Excel, PowerPoint, PDF)", "area": "plugins", "adapter": "claude-code", "needs": ["claude"],
  "check": "(& claude plugin list 2>&1) -match 'document-skills@'",
  "install": ["Add-ClaudePlugin anthropics/skills anthropic-agent-skills document-skills"],
  "check_mac": "claude plugin list 2>&1 | grep -q 'document-skills@'",
  "install_mac": ["claude plugin marketplace add anthropics/skills || true", "claude plugin install document-skills@anthropic-agent-skills"]},

 {"id": "notebooklm", "name": "NotebookLM (Google Notebook)", "area": "tools", "needs": ["python"], "check": "Test-Command notebooklm",
  "install": ["python -m pip install --no-warn-script-location \"notebooklm-py[browser]\"", "Add-PythonScriptsPath", "python -m playwright install chromium", "notebooklm skill install"],
  "check_mac": "command -v notebooklm",
  "install_mac": ["uv tool install \"notebooklm-py[browser]\"", "uvx --from \"notebooklm-py[browser]\" playwright install chromium", "notebooklm skill install"],
  "check_linux": "command -v notebooklm >/dev/null || test -x \"$HOME/.local/bin/notebooklm\"",
  "install_linux": ["pip3 install --break-system-packages \"notebooklm-py[browser]\"", "python3 -m playwright install chromium", "PATH=\"$HOME/.local/bin:$PATH\" notebooklm skill install"],
  "login": "Run: notebooklm login. It opens a browser. Sign in with your Google account."},
 {"id": "scrapling", "name": "Scrapling (reads web pages that block normal fetching)", "area": "tools", "needs": ["python"], "check": "Test-Command scrapling",
  "install": ["python -m pip install --no-warn-script-location \"scrapling[fetchers]\"", "Add-PythonScriptsPath", "scrapling install"],
  "check_mac": "command -v scrapling", "install_mac": ["uv tool install \"scrapling[fetchers]\"", "scrapling install"],
  "check_linux": "command -v scrapling >/dev/null || test -x \"$HOME/.local/bin/scrapling\"",
  "install_linux": ["pip3 install --break-system-packages \"scrapling[fetchers]\"", "PATH=\"$HOME/.local/bin:$PATH\" scrapling install"]},
 {"id": "markitdown", "name": "MarkItDown (Word, Excel, PDF to text)", "area": "tools", "needs": ["python"],
  "check": "(& python -c \"import markitdown; print('ok')\" 2>$null) -eq 'ok'",
  "install": ["python -m pip install --no-warn-script-location \"markitdown[all]\"", "Add-PythonScriptsPath"],
  "check_mac": "command -v markitdown", "install_mac": ["uv tool install \"markitdown[all]\""],
  "check_linux": "command -v markitdown >/dev/null || test -x \"$HOME/.local/bin/markitdown\"", "install_linux": ["pip3 install --break-system-packages \"markitdown[all]\""]},
 {"id": "gallery-dl", "name": "gallery-dl (image galleries)", "area": "tools", "needs": ["python"], "check": "Test-Command gallery-dl",
  "install": ["python -m pip install --no-warn-script-location -U gallery-dl", "Add-PythonScriptsPath"], "check_mac": "command -v gallery-dl", "install_mac": ["brew install gallery-dl"],
  "check_linux": "command -v gallery-dl >/dev/null || test -x \"$HOME/.local/bin/gallery-dl\"", "install_linux": ["pip3 install --break-system-packages -U gallery-dl"]},
 {"id": "agent-reach", "name": "Agent Reach (X, Reddit, LinkedIn, YouTube transcripts)", "area": "tools", "needs": ["python", "yt-dlp"], "check": "Test-Command agent-reach",
  "install": ["python -m pip install --no-warn-script-location agent-reach", "Add-PythonScriptsPath"], "check_mac": "command -v agent-reach", "install_mac": ["uv tool install agent-reach"],
  "check_linux": "command -v agent-reach >/dev/null || test -x \"$HOME/.local/bin/agent-reach\"", "install_linux": ["pip3 install --break-system-packages agent-reach"],
  "login": "Run: agent-reach setup. Use throwaway accounts only, never your real ones."},
 {"id": "whisper", "name": "whisper.cpp (speech to text, runs on your computer)", "area": "tools",
  "check": "Test-Path \"$HOME\\tools\\whisper\\bin\\Release\\whisper-cli.exe\"",
  "install": ["New-Item -ItemType Directory -Force -Path \"$HOME\\tools\\whisper\\models\" | Out-Null",
              "Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/ggml-org/whisper.cpp/releases/download/v1.9.1/whisper-blas-bin-x64.zip' -OutFile \"$HOME\\tools\\whisper\\w.zip.part\" -ErrorAction Stop",
              "Move-Item -Force \"$HOME\\tools\\whisper\\w.zip.part\" \"$HOME\\tools\\whisper\\w.zip\" -ErrorAction Stop",
              "Expand-Archive -Force -Path \"$HOME\\tools\\whisper\\w.zip\" -DestinationPath \"$HOME\\tools\\whisper\\bin\"",
              "Remove-Item -Force \"$HOME\\tools\\whisper\\w.zip\""],
  "check_mac": "command -v whisper-cli", "install_mac": ["brew install whisper-cpp"],
  "check_linux": "test -x \"$HOME/tools/whisper/src/build/bin/whisper-cli\"",
  "install_linux": ["$SUDO apt-get update -qq", "$SUDO apt-get install -y build-essential cmake git",
                    "mkdir -p \"$HOME/tools/whisper/models\"",
                    "test -d \"$HOME/tools/whisper/src\" || git clone --depth 1 --branch v1.9.1 https://github.com/ggml-org/whisper.cpp \"$HOME/tools/whisper/src\"",
                    "cmake -S \"$HOME/tools/whisper/src\" -B \"$HOME/tools/whisper/src/build\" -DCMAKE_BUILD_TYPE=Release",
                    "cmake --build \"$HOME/tools/whisper/src/build\" -j --config Release"]},
 {"id": "whisper-model", "name": "whisper.cpp English model", "area": "tools", "needs": ["whisper"],
  "check": "Test-Path \"$HOME\\tools\\whisper\\models\\ggml-base.en.bin\"",
  "install": ["New-Item -ItemType Directory -Force -Path \"$HOME\\tools\\whisper\\models\" | Out-Null",
              "Invoke-WebRequest -UseBasicParsing -Uri 'https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin' -OutFile \"$HOME\\tools\\whisper\\models\\ggml-base.en.bin.part\" -ErrorAction Stop",
              "Move-Item -Force \"$HOME\\tools\\whisper\\models\\ggml-base.en.bin.part\" \"$HOME\\tools\\whisper\\models\\ggml-base.en.bin\" -ErrorAction Stop"],
  "check_mac": "test -f \"$HOME/tools/whisper/models/ggml-base.en.bin\"",
  "install_mac": ["mkdir -p \"$HOME/tools/whisper/models\"",
                  "curl -fsSL -o \"$HOME/tools/whisper/models/ggml-base.en.bin.part\" https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin",
                  "mv -f \"$HOME/tools/whisper/models/ggml-base.en.bin.part\" \"$HOME/tools/whisper/models/ggml-base.en.bin\""],
  "check_linux": "test -f \"$HOME/tools/whisper/models/ggml-base.en.bin\"",
  "install_linux": ["mkdir -p \"$HOME/tools/whisper/models\"",
                    "curl -fsSL -o \"$HOME/tools/whisper/models/ggml-base.en.bin.part\" https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin",
                    "mv -f \"$HOME/tools/whisper/models/ggml-base.en.bin.part\" \"$HOME/tools/whisper/models/ggml-base.en.bin\""]},

